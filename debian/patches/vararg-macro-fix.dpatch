#!/bin/sh -e
## vararg_macro_fix.dpatch by Timshel Knoll <timshel@debian.org>
##
## All lines beginning with `## DP:' are a description of the patch.
## DP: No description.

if [ $# -lt 1 ]; then
    echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
    exit 1
fi

[ -f debian/patches/00patch-opts ] && . debian/patches/00patch-opts
patch_opts="${patch_opts:--f --no-backup-if-mismatch}"

case "$1" in
       -patch) patch $patch_opts -p1 < $0;;
       -unpatch) patch $patch_opts -p1 -R < $0;;
        *)
                echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
                exit 1;;
esac

exit 0

@DPATCH@
diff -urNad /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/e2dump.c defrag-0.73pjm1/e2dump.c
--- /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/e2dump.c	2001-07-04 21:08:13.000000000 +1000
+++ defrag-0.73pjm1/e2dump.c	2004-02-11 16:58:58.000000000 +1100
@@ -92,7 +92,7 @@
 
 #define UPPER(size,n)		((size + ((n) - 1)) / (n))
 
-#define my_printf(a...) do { if (!quiet) printf(##a); } while(0)
+#define my_printf(a...) do { if (!quiet) printf(a); } while(0)
 
 static int IN;         /* Input device handle */
 
