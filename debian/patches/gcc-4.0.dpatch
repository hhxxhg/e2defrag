#!/bin/sh -e
## gcc-4.0.dpatch by Goswin von Brederlow <brederlo@informatik.uni-tuebingen.de>
##
## All lines beginning with `## DP:' are a description of the patch.
## DP: No description.

if [ $# -lt 1 ]; then
    echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
    exit 1
fi

[ -f debian/patches/00patch-opts ] && . debian/patches/00patch-opts
patch_opts="${patch_opts:--f --no-backup-if-mismatch}"

case "$1" in
       -patch) patch $patch_opts -p1 < $0;;
       -unpatch) patch $patch_opts -p1 -R < $0;;
        *)
                echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
                exit 1;;
esac

exit 0

@DPATCH@
diff -Nurd defrag-0.73pjm1/defrag.h defrag-0.73pjm1-gcc4.0/defrag.h
--- defrag-0.73pjm1/defrag.h	2001-07-04 11:08:13.000000000 +0000
+++ defrag-0.73pjm1-gcc4.0/defrag.h	2006-01-20 14:45:24.143742768 +0000
@@ -140,7 +140,7 @@
 	unsigned int full : 1; /* contains data */
 	Buffer *next;
 	Block dest_zone;
-	unsigned char data[0];
+	char data[0];
 };
 
 
diff -Nurd defrag-0.73pjm1/display.c defrag-0.73pjm1-gcc4.0/display.c
--- defrag-0.73pjm1/display.c	2001-07-04 11:08:13.000000000 +0000
+++ defrag-0.73pjm1-gcc4.0/display.c	2006-01-20 14:55:45.760242696 +0000
@@ -46,11 +47,14 @@
 static RETSIGTYPE
 tstp_signal(int dummy)
 {
+   sigset_t emptyset;
    UNUSED(dummy);
 
    endwin();
    signal(SIGTSTP,SIG_DFL);
-   sigsetmask(0);
+   /* sigsetmask(0); */
+   sigemptyset(&emptyset);
+   sigprocmask(SIG_SETMASK, &emptyset, NULL);
    /* Put us to stop */
    kill(getpid(),SIGTSTP);     
    
--- defrag-0.73pjm1/llseek.c	2001-07-04 11:08:13.000000000 +0000
+++ defrag-0.73pjm1/llseek.c	2006-01-20 15:31:41.062586936 +0000
@@ -25,8 +25,12 @@
  *   o #include "llseek.h", which provides loff_t.
  */
 
+#ifndef _LARGEFILE_SOURCE
 #define _LARGEFILE_SOURCE
+#endif
+#ifndef _LARGEFILE64_SOURCE
 #define _LARGEFILE64_SOURCE
+#endif
 
 #include <config.h>
 
--- defrag-0.73pjm1/e2dump.c	2006-01-20 16:00:11.064627112 +0000
+++ defrag-0.73pjm1/e2dump.c	2006-01-20 16:01:16.925614720 +0000
@@ -53,12 +53,12 @@
 } *gt;
 
 #if defined(__i386__) && defined(__GNUC__)
-static inline int bit_is_set(char * bitmap,unsigned int nr) 
+static inline int bit_is_set(const void * bitmap, unsigned int nr) 
 { 
 	int __res; 
 	__asm__ __volatile__("btl %1,%2; adcl $0,%0" 
 		:"=g" (__res) 
-		:"r" (nr),"m" (*(bitmap)),"0" (0)); 
+		:"r" (nr),"m" (*(const char*)(bitmap)),"0" (0)); 
 	return __res; 
 }
 #else
