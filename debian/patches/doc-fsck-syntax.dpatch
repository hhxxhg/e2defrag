#!/bin/sh -e
## doc-fsck-syntax.dpatch by Timshel Knoll <timshel@debian.org>
##
## All lines beginning with `## DP:' are a description of the patch.
## DP: No description.

if [ $# -lt 1 ]; then
    echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
    exit 1
fi

[ -f debian/patches/00patch-opts ] && . debian/patches/00patch-opts
patch_opts="${patch_opts:--f --no-backup-if-mismatch}"

case "$1" in
       -patch) patch $patch_opts -p1 < $0;;
       -unpatch) patch $patch_opts -p1 -R < $0;;
        *)
                echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
                exit 1;;
esac

exit 0

@DPATCH@
diff -urNad /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/README defrag-0.73pjm1/README
--- /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/README	2001-07-04 21:08:13.000000000 +1000
+++ defrag-0.73pjm1/README	2004-02-11 17:30:10.000000000 +1100
@@ -145,7 +145,7 @@
 In particular, there is limited handling of read/write errors in the
 defragmenter.  defrag DOES understand the bad block inode
 (and the special handling now works - as of version 0.3b), so if you
-suspect you might have bad blocks, try running fsck -t (test for bad
+suspect you might have bad blocks, try running fsck -c -c (test for bad
 blocks) before defragmenting.
 
 As of version 0.4, the defragmenter tries to recover as gracefully as
