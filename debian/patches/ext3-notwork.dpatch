#!/bin/sh -e
## fail_on_ext3.dpatch by Timshel Knoll <timshel@debian.org>
##
## All lines beginning with `## DP:' are a description of the patch.
## DP: No description.

if [ $# -lt 1 ]; then
    echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
    exit 1
fi

[ -f debian/patches/00patch-opts ] && . debian/patches/00patch-opts
patch_opts="${patch_opts:--f --no-backup-if-mismatch}"

case "$1" in
       -patch) patch $patch_opts -p1 < $0;;
       -unpatch) patch $patch_opts -p1 -R < $0;;
        *)
                echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
                exit 1;;
esac

exit 0

@DPATCH@
diff -urNad /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/ext2.c defrag-0.73pjm1/ext2.c
--- /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/ext2.c	2001-07-04 21:08:13.000000000 +1000
+++ defrag-0.73pjm1/ext2.c	2004-02-11 16:57:59.000000000 +1100
@@ -117,6 +117,13 @@
 					| EXT2_FEATURE_INCOMPAT_FILETYPE)))
       die( "filesystem has unsupported features");
 
+    /*
+     * Added by Timshel Knoll <timshel@pobox.com>, 27/10/02
+     * e2defrag doesn't support ext3 journals (yet)
+     */ 
+    if(Super.s_feature_compat & EXT3_FEATURE_COMPAT_HAS_JOURNAL)
+      die("ext3 filesystems not (yet) supported");
+
     block_size = EXT2_MIN_BLOCK_SIZE << Super.s_log_block_size;
 
     groups = (Super.s_blocks_count - Super.s_first_data_block + 
