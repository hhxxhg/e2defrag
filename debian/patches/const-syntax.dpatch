#!/bin/sh -e
## const_syntax_fix.dpatch by Timshel Knoll <timshel@debian.org>
##
## All lines beginning with `## DP:' are a description of the patch.
## DP: No description.

if [ $# -lt 1 ]; then
    echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
    exit 1
fi

[ -f debian/patches/00patch-opts ] && . debian/patches/00patch-opts
patch_opts="${patch_opts:--f --no-backup-if-mismatch}"

case "$1" in
       -patch) patch $patch_opts -p1 < $0;;
       -unpatch) patch $patch_opts -p1 -R < $0;;
        *)
                echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
                exit 1;;
esac

exit 0

@DPATCH@
diff -urNad /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/buffers.c defrag-0.73pjm1/buffers.c
--- /home/timshel/src/debian/dpatch/tmp/defrag-0.73pjm1/buffers.c	2001-07-04 21:08:13.000000000 +1000
+++ defrag-0.73pjm1/buffers.c	2004-02-11 16:58:25.000000000 +1100
@@ -252,8 +252,8 @@
 static int compare_buffer_zones(const void *a, const void *b)
 {
 	Block azone, bzone;
-	azone = (*((Buffer const **) a))->dest_zone;
-	bzone = (*((Buffer const **) b))->dest_zone;
+	azone = (*((Buffer const * const *) a))->dest_zone;
+	bzone = (*((Buffer const * const *) b))->dest_zone;
 	
 	if (azone < bzone)
 		return -1;
@@ -266,8 +266,8 @@
 static int compare_buffer_zones_for_read (const void *a, const void *b)
 {
 	Block azone, bzone;
-	azone = n2d((*((Buffer const **) a))->dest_zone);
-	bzone = n2d((*((Buffer const **) b))->dest_zone);
+	azone = n2d((*((Buffer const * const *) a))->dest_zone);
+	bzone = n2d((*((Buffer const * const *) b))->dest_zone);
 	
 	if (azone < bzone)
 		return -1;
