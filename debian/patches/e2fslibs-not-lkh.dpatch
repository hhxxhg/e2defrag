#!/bin/sh -e
## e2fslibs-not-lkh.dpatch by Timshel Knoll <timshel@debian.org>
##
## All lines beginning with `## DP:' are a description of the patch.
## DP: No description.

if [ $# -lt 1 ]; then
    echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
    exit 1
fi

[ -f debian/patches/00patch-opts ] && . debian/patches/00patch-opts
patch_opts="${patch_opts:--f --no-backup-if-mismatch}"

case "$1" in
       -patch) patch $patch_opts -p1 < $0;;
       -unpatch) patch $patch_opts -p1 -R < $0;;
        *)
                echo >&2 "`basename $0`: script expects -patch|-unpatch as argument"
                exit 1;;
esac

exit 0

@DPATCH@
diff -urNad /home/timshel/src/debian/dpatch/defrag/defrag-0.73pjm1/configure.in defrag-0.73pjm1/configure.in
--- /home/timshel/src/debian/dpatch/defrag/defrag-0.73pjm1/configure.in	2004-02-23 08:02:58.000000000 +1100
+++ defrag-0.73pjm1/configure.in	2004-02-23 08:04:41.000000000 +1100
@@ -92,7 +92,22 @@
 ])
 enable_fs(minix)
 enable_fs(ext)
-enable_fs(ext2)
+
+AC_ARG_ENABLE(ext2,
+[  --disable-ext2 	  Don't support ext2 filesystems.])
+if test x"$enable_ext2" = x"no"; then
+  USE_ext2=
+else
+  AC_CHECK_HEADER(ext2fs/ext2_fs.h, USE_ext2=1,
+[  if test x"$enable_ext2" = x"yes"; then
+    AC_MSG_ERROR([ext2fs/ext2_fs.h not found, cannot enable ext2 support])
+  else
+    echo "configure: note: ext2fs/ext2_fs.h not found, disabling ext2 support" 1>&2
+  fi
+  USE_ext2=])
+fi
+AC_SUBST(USE_ext2)
+
 enable_fs(xia)
 
 
diff -urNad /home/timshel/src/debian/dpatch/defrag/defrag-0.73pjm1/e2dump.c defrag-0.73pjm1/e2dump.c
--- /home/timshel/src/debian/dpatch/defrag/defrag-0.73pjm1/e2dump.c	2004-02-23 08:02:58.000000000 +1100
+++ defrag-0.73pjm1/e2dump.c	2004-02-23 08:04:19.000000000 +1100
@@ -22,7 +22,7 @@
 #include <unistd.h>
 #include <fcntl.h>
 #include <time.h>
-#include <linux/ext2_fs.h>
 #include "types.h"
+#include <ext2fs/ext2_fs.h>
 #include "ext2.h"
 #include "display.h"
diff -urNad /home/timshel/src/debian/dpatch/defrag/defrag-0.73pjm1/ext2.h defrag-0.73pjm1/ext2.h
--- /home/timshel/src/debian/dpatch/defrag/defrag-0.73pjm1/ext2.h	2004-02-23 08:02:58.000000000 +1100
+++ defrag-0.73pjm1/ext2.h	2004-02-23 08:04:19.000000000 +1100
@@ -12,10 +12,10 @@
  *
  */
 
-#include <linux/fs.h>
-#include <linux/ext2_fs.h>
-#include <linux/ext2_fs_i.h>
-#include <linux/ext2_fs_sb.h>
+/*#include <linux/fs.h>*/
+#include <ext2fs/ext2_fs.h>
+/*#include <ext2fs/ext2_fs_i.h>
+ *#include <ext2fs/ext2_fs_sb.h>*/
 
 #define HAS_TIND
 
