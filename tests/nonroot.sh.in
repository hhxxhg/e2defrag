#! /bin/sh
# @configure_input@
set -e
srcdir="@srcdir@"

rm -f "test,$1"

bzip2 -d < "$srcdir/before,$1".bz2 > test,"$1"

# Test that readonly really is readonly.
../e2defrag -rn test,"$1" >/dev/null
bzip2 -d < "$srcdir/before,$1.bz2" | cmp - test,"$1"

# Test that e2defrag produces same output as on the machine where
# top.sh was run.
../e2defrag -n test,"$1" >/dev/null
bzip2 -d < "$srcdir/after,$1.bz2" | cmp - test,"$1"

rm "test,$1"
